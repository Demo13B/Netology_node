<%- include('../port/layout-start', {title: title}) %>
    <%- include('../port/menu') %>

        <h1>
            <%= title %>
        </h1>

        <div class="row">
            <div class="col-sm-8">
                <div class="card">
                    <div class="card-body">

                        <h5 class="card-title">
                            <%= book.title %>
                        </h5>

                        <p class="card-text">
                            <%= book.description %>
                        </p>

                        <p><strong>Автор(ы):</strong>
                            <%= book.authors %>
                        </p>

                        <p><strong>Избранная:</strong>
                            <%= book.favorite ? 'Да' : 'Нет' %>
                        </p>

                        <p><strong>Файл книги:</strong>
                            <a href="/books/<%= book._id %>/download">Скачать</a>
                        </p>

                        <p><strong>Количество просмотров: </strong>
                            <%= count %>
                        </p>

                        <div class="text-right">
                            <a class="btn btn-sm btn-primary" href="/books/update/<%= book._id %>">
                                <i class="fa fa-pencil" aria-hidden="true"></i>
                            </a>
                        </div>

                        <button onclick="deleteBook('<%=book._id %>')" class="btn btn-sm btn-danger">
                            <i class="fa fa-trash"></i>
                        </button>

                        <script>
                            function deleteBook(id) {
                                fetch(`/api/books/${id}`, { method: 'DELETE' })
                                    .then(() => window.location.href = '/books');
                            }
                        </script>

                    </div>
                </div>
            </div>
        </div>

        <h2>Комментарии</h2>
        <div id="comments">
            <div class="row">
                <div class="col-8">
                    <% comments.forEach(comment=> { %>
                        <%- include('comment', { createdAt: comment.createdAt, message: comment.message }) %>
                            <% }) %>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-8">
                <div id="list" class="list-group">

                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-8">
                <div class="form-group">
                    <label for="text">Оставить комментарий</label>
                    <textarea placeholder="" class="form-control" id="text"></textarea>
                </div>
                <button type="submit" id="send" class="btn btn-primary">Опубликовать</button>
            </div>
        </div>

        <script>
            const bookId = '<%- String(book._id) %>';
            const socket = io.connect('/', { query: `roomName=book_${bookId}` });
            const boxList = document.querySelector('#list');
            const text = document.querySelector('#text');
            const send = document.querySelector('#send');

            const getTmp = (comment) => {
                div = `<div class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between">
                        <small>
                            ${comment.createdAt}
                        </small>
                    </div>
                    <p class="mb-1">
                        ${comment.message}
                    </p>
                </div>`;
                return div;
            }

            send.addEventListener('click', () => {
                console.log('Yes');
                socket.emit('message', {
                    book: bookId,
                    message: text.value,
                    createdAt: (new Date()).toString()
                });
            });

            socket.on('message', (msg) => {
                const div = getTmp(msg);
                boxList.insertAdjacentHTML('beforeend', div);
            });

        </script>


        <%- include('../port/layout-end') %>